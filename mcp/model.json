                            "boolean",
                            "filepath"
                          ]
                        },
                        "value": {
                          "name": "value",
                          "type": "string",
                          "description": "The value, with variable substitution support."
                        },
                        "default": {
                          "name": "default",
                          "type": "string",
                          "description": "Default value."
                        },
                        "choices": {
                          "name": "choices",
                          "type": "array",
                          "description": "List of permitted values.",
                          "item": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            },
            "icons": {
              "name": "icons",
              "type": "array",
              "description": "Set of sized icons that can be displayed in a user interface.",
              "item": {
                "type": "object",
                "attributes": {
                  "src": {
                    "name": "src",
                    "type": "url",
                    "required": true,
                    "description": "A standard URI pointing to an icon resource. MUST be an HTTPS URL of at most 255 characters. REQUIRED upstream."
                  },
                  "mime_type": {
                    "name": "mime_type",
                    "type": "string",
                    "description": "Optional MIME type override. Projects the upstream `mimeType` field.",
                    "strict": false,
                    "enum": [
                      "image/png",
                      "image/jpeg",
                      "image/jpg",
                      "image/svg+xml",
                      "image/webp"
                    ]
                  },
                  "sizes": {
                    "name": "sizes",
                    "type": "array",
                    "description": "Array of sizes, each either '<width>x<height>' in decimal digits or the literal 'any'. Examples: '48x48', '96x96', 'any'.",
                    "item": {
                      "type": "string"
                    }
                  },
                  "theme": {
                    "name": "theme",
                    "type": "string",
                    "description": "Theme this icon is designed for.",
                    "enum": [
                      "light",
                      "dark"
                    ]
                  }
                }
              }
            },
            "repository": {
              "name": "repository",
              "type": "object",
              "description": "Repository metadata for the MCP server source code.",
              "attributes": {
                "url": {
                  "name": "url",
                  "type": "url",
                  "required": true,
                  "description": "Repository URL for browsing source code. REQUIRED upstream when `repository` is present."
                },
                "source": {
                  "name": "source",
                  "type": "string",
                  "required": true,
                  "description": "Repository hosting service identifier (e.g., github, gitlab). REQUIRED upstream when `repository` is present."
                },
                "id": {
                  "name": "id",
                  "type": "string",
                  "description": "Repository identifier from the hosting service."
                },
                "subfolder": {
                  "name": "subfolder",
                  "type": "string",
                  "description": "Optional relative path from repository root to the server location."
                }
              }
            },
            "publisher_meta": {
              "name": "publisher_meta",
              "type": "map",
              "description": "Publisher-provided metadata carried in the server object's `_meta` under the reserved key `io.modelcontextprotocol.registry/publisher-provided`. This is Version data: the publisher supplies it as part of the server release, and upstream limits it to 4 KB. All other `_meta` keys inside the server object are silently discarded on publish, so only this one is projected. Named `publisher_meta` rather than `_meta` because `_` is not a legal leading character for an xRegistry attribute name.",
              "item": {
                "type": "any"
              }
            }
          },
          "metaattributes": {
            "status": {
              "type": "string",
              "description": "Registry lifecycle status of the server, projected from the response-level `_meta[\"io.modelcontextprotocol.registry/official\"].status`. Registry-managed, never publisher-supplied, which is why it lives on `meta` and not on the Version.",
              "enum": [
                "active",
                "deprecated",
                "deleted"
              ]
            },
            "status_message": {
              "type": "string",
              "description": "Human-readable explanation of the current `status`, of at most 500 characters upstream. Projects `statusMessage`."
            },
            "status_changed_at": {
              "type": "timestamp",
              "description": "When `status` last changed. Projects `statusChangedAt`."
            },
            "published_at": {
              "type": "timestamp",
              "description": "When the registry first published the default Version of this server. Projects `publishedAt`."
            },
            "updated_at": {
              "type": "timestamp",
              "description": "When the registry last updated the default Version of this server. Projects `updatedAt`."
            },
            "is_latest": {
              "type": "boolean",
              "description": "Whether the default Version is the one the registry considers latest. Projects `isLatest`."
            }
          }
        }
      }
    }
  }
}