{
  "groups": {
    "mcpproviders": {
      "plural": "mcpproviders",
      "singular": "mcpprovider",
      "description": "Registry of Model Context Protocol (MCP) servers and their capabilities, organized by provider.",
      "resources": {
        "servers": {
          "plural": "servers",
          "singular": "server",
          "maxversions": 0,
          "setversionid": true,
          "hasdocument": false,
          "singleversionroot": false,
          "labels": {},
          "attributes": {
            "schemaurl": {
              "name": "schemaurl",
              "type": "url",
              "description": "JSON Schema URI for the server.json format (e.g., https://static.modelcontextprotocol.io/schemas/2025-10-17/server.schema.json). Renamed from upstream `$schema` to satisfy xRegistry attribute-name rules (no `$` allowed in attribute names per core spec §\"Attribute Name Rules\")."
            },
            "name": {
              "name": "name",
              "type": "string",
              "required": true,
              "description": "Reverse-DNS MCP server name containing exactly one `/`, carried verbatim from the upstream `name` field. Upstream constrains this to at most 200 characters. REQUIRED upstream."
            },
            "description": {
              "name": "description",
              "type": "string",
              "required": true,
              "description": "Human-readable explanation of the server's purpose. Upstream constrains this to at most 100 characters. REQUIRED upstream."
            },
            "title": {
              "name": "title",
              "type": "string",
              "description": "Human-readable title or display name for the MCP server. Upstream constrains this to at most 100 characters."
            },
            "website_url": {
              "name": "website_url",
              "type": "url",
              "description": "Optional URL to the server's homepage or documentation. Projects the upstream `websiteUrl` field; renamed because xRegistry attribute names MUST match `[a-z0-9_]`."
            },
            "version": {
              "name": "version",
              "type": "string",
              "required": true,
              "description": "Semantic version number of the server release. Upstream constrains this to at most 255 characters. REQUIRED upstream."
            },
            "packages": {
              "name": "packages",
              "type": "array",
              "description": "Package registry metadata blocks per server.json schema.",
              "item": {
                "type": "object",
                "attributes": {
                  "registry_type": {
                    "name": "registry_type",
                    "type": "string",
                    "required": true,
                    "description": "Type of registry (npm, pypi, oci, nuget, mcpb). Projects the upstream `registryType` field. REQUIRED upstream.",
                    "enum": [
                      "npm",
                      "pypi",
                      "oci",
                      "nuget",
                      "mcpb"
                    ],
                    "ifvalues": {
                      "npm": {
                        "siblingattributes": {
                          "packagexid": {
                            "name": "packagexid",
                            "type": "xid",
                            "description": "xRegistry ID referencing the NPM package.",
                            "target": "/nodescopes/packages"
                          }
                        }
                      },
                      "pypi": {
                        "siblingattributes": {
                          "packagexid": {
                            "name": "packagexid",
                            "type": "xid",
                            "description": "xRegistry ID referencing the PyPI package.",
                            "target": "/pythonregistries/packages"
                          }
                        }
                      },
                      "oci": {
                        "siblingattributes": {
                          "packagexid": {
                            "name": "packagexid",
                            "type": "xid",
                            "description": "xRegistry ID referencing the container image.",
                            "target": "/containerregistries/images"
                          }
                        }
                      },
                      "nuget": {
                        "siblingattributes": {
                          "packagexid": {
                            "name": "packagexid",
                            "type": "xid",
                            "description": "xRegistry ID referencing the NuGet package.",
                            "target": "/dotnetregistries/packages"
                          }
                        }
                      },
                      "mcpb": {
                        "siblingattributes": {
                          "packagexid": {
                            "name": "packagexid",
                            "type": "uri",
                            "description": "URI referencing the MCP bundle. MCP bundles are distributed as files rather than as xRegistry Resources, so this is a plain URI and not an xid."
                          }
                        }
                      }
                    }
                  },
                  "registry_base_url": {
                    "name": "registry_base_url",
                    "type": "url",
                    "description": "Base URL of the package registry. Projects the upstream `registryBaseUrl` field."
                  },
                  "identifier": {
                    "name": "identifier",
                    "type": "string",
                    "required": true,
                    "description": "Package identifier - either package name (for registries) or URL (for direct downloads). REQUIRED upstream."
                  },
                  "version": {
                    "name": "version",
                    "type": "string",
                    "description": "Package version. MUST be one exact version. Upstream forbids the literal value `latest` and rejects version ranges; xRegistry has no vocabulary for either constraint, so implementations MUST enforce them when projecting."
                  },
                  "file_sha256": {
                    "name": "file_sha256",
                    "type": "string",
                    "description": "SHA-256 hash of the package file for integrity verification, as 64 lowercase hexadecimal characters. Projects the upstream `fileSha256` field."
                  },
                  "runtime_hint": {
                    "name": "runtime_hint",
                    "type": "string",
                    "description": "Hint for the appropriate runtime (npx, uvx, docker, dnx). Projects the upstream `runtimeHint` field.",
                    "enum": [
                      "npx",
                      "uvx",
                      "docker",
                      "dnx"
                    ]
                  },
                  "transport": {
                    "name": "transport",
                    "type": "object",
                    "required": true,
                    "description": "Transport protocol configuration (stdio, streamable-http, sse). REQUIRED upstream: a Package that does not say how it is reached cannot be launched.",
                    "attributes": {
                      "type": {
                        "name": "type",
                        "type": "string",
                        "required": true,
                        "description": "Transport type. REQUIRED upstream.",
                        "enum": [
                          "stdio",
                          "streamable-http",
                          "sse"
                        ]
                      },
                      "url": {
                        "name": "url",
                        "type": "url",
                        "description": "URL for streamable-http or sse transports."
                      },
                      "headers": {
                        "name": "headers",
                        "type": "array",
                        "description": "HTTP headers for streamable-http or sse transports.",
                        "item": {
                          "type": "object",
                          "attributes": {
                            "name": {
                              "name": "name",
                              "type": "string",
                              "description": "Header or environment variable name."
                            },
                            "description": {
                              "name": "description",
                              "type": "string",
                              "description": "Description of the header."
                            },
                            "default": {
                              "name": "default",
                              "type": "string",
                              "description": "Default value."
                            },
                            "is_required": {
                              "name": "is_required",
                              "type": "boolean",
                              "description": "Whether required. Projects the upstream `isRequired` field."
                            },
                            "is_secret": {
                              "name": "is_secret",
                              "type": "boolean",
                              "description": "Whether secret. Projects the upstream `isSecret` field."
                            },
                            "format": {
                              "name": "format",
                              "type": "string",
                              "description": "Input format.",
                              "enum": [
                                "string",
                                "number",
                                "boolean",
                                "filepath"
                              ]
                            },
                            "value": {
                              "name": "value",
                              "type": "string",
                              "description": "The value with variable substitution support."
                            },
                            "placeholder": {
                              "name": "placeholder",
                              "type": "string",
                              "description": "Placeholder text."
                            },
                            "choices": {
                              "name": "choices",
                              "type": "array",
                              "description": "List of possible values.",
                              "item": {
                                "type": "string"
                              }
                            },
                            "variables": {
                              "name": "variables",
                              "type": "map",
                              "description": "Substitution variables referenced by `value`, keyed by variable name. Upstream this is an open map whose values are Input objects.",
                              "item": {
                                "type": "object",
                                "attributes": {
                                  "description": {
                                    "name": "description",
                                    "type": "string",
                                    "description": "Description of the variable."
