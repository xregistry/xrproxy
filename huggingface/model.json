{
  "groups": {
    "huggingfaceregistries": {
      "plural": "huggingfaceregistries",
      "singular": "huggingfaceregistry",
      "description": "A Hugging Face owner namespace; _ is reserved for unnamespaced repositories.",
      "resources": {
        "models": {
          "plural": "models",
          "singular": "model",
          "description": "A Hugging Face model whose resource ID is the repository basename within its owner group.",
          "hasdocument": false,
          "attributes": {
            "name": {
              "type": "string",
              "required": true,
              "description": "The full Hub repository identity in 'owner/name' form, verbatim and unaltered including the '/' separator. This is the authoritative name of the repository; the modelid is only the basename and does not identify the repository on its own."
            },
            "repoid": {
              "type": "string",
              "description": "Full Hugging Face repository ID (owner/name or name), taken from the Hub 'id' field."
            },
            "author": {
              "type": "string",
              "description": "Owner / organisation of the model."
            },
            "sha": {
              "type": "string",
              "description": "Current HEAD commit SHA (default branch tip)."
            },
            "repository": {
              "type": "string",
              "description": "Canonical owner/repository ID, or the bare ID for an unnamespaced repository."
            },
            "namespace": {
              "type": "string",
              "description": "Canonical owner namespace, or empty for an unnamespaced repository."
            },
            "message": {
              "type": "string",
              "description": "Commit title or message for a Version."
            },
            "siblings": {
              "type": "array",
              "description": "File manifest of this commit, from the Hub 'siblings' field.",
              "item": {
                "type": "object",
                "attributes": {
                  "rfilename": {
                    "type": "string",
                    "description": "Repository-relative file name."
                  },
                  "size": {
                    "type": "uinteger",
                    "description": "File size in bytes, present only when blob details are requested."
                  },
                  "blobid": {
                    "type": "string",
                    "description": "Git blob SHA, from 'blobId', present only when blob details are requested."
                  },
                  "lfs": {
                    "type": "object",
                    "description": "Git LFS pointer details, present only for LFS-tracked files.",
                    "attributes": {
                      "size": {
                        "type": "uinteger",
                        "description": "Size in bytes of the LFS object."
                      },
                      "sha256": {
                        "type": "string",
                        "description": "SHA-256 digest of the LFS object."
                      },
                      "pointersize": {
                        "type": "uinteger",
                        "description": "Size in bytes of the LFS pointer file, from 'pointerSize'."
                      }
                    }
                  }
                }
              }
            }
          },
          "maxversions": 0,
          "setversionid": true,
          "versionmode": "manual",
          "singleversionroot": false,
          "metaattributes": {
            "defaultversionsticky": {
              "type": "boolean",
              "description": "Sticky default Versions are not supported: the default Version always tracks the default branch tip.",
              "enum": [ false ],
              "required": true,
              "default": false
            },
            "private": {
              "type": "boolean",
              "description": "Whether the repository is private."
            },
            "gated": {
              "type": "any",
              "description": "Gated-access status as returned by the Hub (false, 'auto', or 'manual')."
            },
            "disabled": {
              "type": "boolean",
              "description": "Whether the repository has been disabled by the Hub."
            },
            "used_storage": {
              "type": "uinteger",
              "description": "Storage consumed by the repository in bytes, from 'usedStorage'."
            },
            "downloads": {
              "type": "uinteger",
              "description": "Total download count (anonymously visible)."
            },
            "likes": {
              "type": "uinteger",
              "description": "Like count."
            },
            "card_data": {
              "type": "object",
              "namecharset": "extended",
              "description": "Model card front matter, from 'cardData'.",
              "attributes": {
                "license": {
                  "type": "string",
                  "description": "License identifier declared in the card front matter."
                },
                "*": {
                  "type": "any",
                  "description": "Any other model card front matter key."
                }
              }
            },
            "pipeline_tag": {
              "type": "string",
              "description": "Primary ML task pipeline tag."
            },
            "library_name": {
              "type": "string",
              "description": "Primary ML library (e.g., transformers, diffusers)."
            },
            "config": {
              "type": "object",
              "namecharset": "extended",
              "description": "Model configuration summary, from 'config'.",
              "attributes": {
                "*": {
                  "type": "any",
                  "description": "Any configuration key, such as architectures or model_type."
                }
              }
            },
            "transformers_info": {
              "type": "object",
              "description": "Transformers auto-class information, from 'transformersInfo'.",
              "attributes": {
                "auto_model": {
                  "type": "string",
                  "description": "Auto model class name, from 'auto_model'."
                },
                "pipeline_tag": {
                  "type": "string",
                  "description": "Pipeline tag reported by the Transformers integration."
                },
                "processor": {
                  "type": "string",
                  "description": "Processor or tokenizer class name."
                }
              }
            },
            "safetensors": {
              "type": "object",
              "description": "Safetensors weight summary.",
              "attributes": {
                "parameters": {
                  "type": "map",
                  "item": {
                    "type": "uinteger"
                  },
                  "description": "Parameter count per tensor dtype."
                },
                "total": {
                  "type": "uinteger",
                  "description": "Total parameter count."
                }
              }
            },
            "model_index": {
              "type": "array",
              "item": {
                "type": "any"
              },
              "description": "Evaluation results declared in the card, from 'model-index'."
            },
            "inference": {
              "type": "any",
              "description": "Inference provider availability as returned by the Hub."
            },
            "widget_data": {
              "type": "array",
              "item": {
                "type": "any"
              },
              "description": "Example inputs shown by the Hub widget, from 'widgetData'."
            },
            "tags": {
              "type": "array",
              "item": {
                "type": "string"
              },
              "description": "Repository tags."
            },
            "refs": {
              "type": "object",
              "attributes": {
                "branches": {
                  "type": "array",
                  "item": {
                    "type": "object",
                    "attributes": {
                      "name": {
                        "type": "string",
                        "description": "Short branch name."
                      },
                      "ref": {
                        "type": "string",
                        "description": "Fully qualified Git ref, e.g. refs/heads/main."
                      },
                      "targetcommit": {
                        "type": "string",
                        "description": "Commit SHA the ref points at, from 'targetCommit'."
                      }
                    }
                  }
                },
                "tags": {
                  "type": "array",
                  "item": {
                    "type": "object",
                    "attributes": {
                      "name": {
                        "type": "string",
                        "description": "Short tag name."
                      },
                      "ref": {
                        "type": "string",
                        "description": "Fully qualified Git ref, e.g. refs/tags/v1.0."
                      },
                      "targetcommit": {
                        "type": "string",
                        "description": "Commit SHA the ref points at, from 'targetCommit'."
                      }
                    }
                  }
                },
                "converts": {
                  "type": "array",
                  "item": {
                    "type": "object",
                    "attributes": {
                      "name": {
                        "type": "string",
                        "description": "Short conversion ref name."
                      },
                      "ref": {
                        "type": "string",
                        "description": "Fully qualified Git ref, e.g. refs/convert/parquet."
                      },
                      "targetcommit": {
                        "type": "string",
                        "description": "Commit SHA the ref points at, from 'targetCommit'."
                      }
                    }
                  }
                }
              },
              "description": "Mutable branch, tag and conversion aliases with their target commit SHAs."
            }
          }
        },
